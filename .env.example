# Environment variables for iiif-3d-viewer.
#
# Local development: copy this file to `.env.local` and fill in values.
# Production: set each variable in the Vercel project's Environment Variables
# (Production target). Preview/local are intentionally left unset so analytics
# only records real production traffic.

# === Google Analytics 4 ===
# Public Measurement ID for the GA4 web stream. This value is public (it is
# emitted into the page source for every visitor), so it is not a secret.
# Set this only in Vercel's Production environment.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
